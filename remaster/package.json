{
  "name": "trampolin-remaster",
  "productName": "Trampolín Remaster",
  "version": "0.1.0",
  "description": "Reimplementación moderna de la serie Trampolín (JumpStart) que usa los discos originales del usuario.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "electron .",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "@types/node": "22.15.21",
    "electron": "44.4.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
